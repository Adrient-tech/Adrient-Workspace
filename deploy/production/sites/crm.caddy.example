# install.sh copies this to /opt/adrient-workspace/sites/crm.caddy when the
# CRM is enabled. The adrient app proxies requests for this Host to Twenty.
{$CRM_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy adrient:8080 {
		flush_interval -1
	}
}
